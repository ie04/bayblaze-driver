rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isDriver(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function changedVehicleLinkFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'linkedDriverUid',
        'linkedAt',
        'updatedAt',
      ]);
    }

    function canLinkVehicleToSelf() {
      return signedIn()
        && changedVehicleLinkFieldsOnly()
        && resource.data.active == true
        && !resource.data.keys().hasAny(['linkedDriverUid'])
        && request.resource.data.linkedDriverUid == request.auth.uid
        && request.resource.data.linkedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function canUnlinkOwnVehicle() {
      return signedIn()
        && changedVehicleLinkFieldsOnly()
        && resource.data.linkedDriverUid == request.auth.uid
        && !request.resource.data.keys().hasAny(['linkedDriverUid', 'linkedAt'])
        && request.resource.data.updatedAt == request.time;
    }

    match /driver_allowlist/{emailKey} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    match /driver_profiles/{uid} {
      allow read, create, update: if isDriver(uid);
      allow delete: if false;
    }

    match /vehicles/{vehicleId} {
      allow read: if signedIn();
      allow update: if canLinkVehicleToSelf() || canUnlinkOwnVehicle();
      allow create, delete: if false;
    }

    match /driver_location_snapshots/{uid} {
      allow read, create, update: if isDriver(uid);
      allow delete: if false;
    }

    match /delivery_attempt_logs/{logId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /driver_signup_codes/{emailKey} {
      allow read, write: if false;
    }
  }
}
